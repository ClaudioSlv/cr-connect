# Copie para .env.local. Nunca envie valores reais ao Git.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE
# InfinitePay: use a InfiniteTag sem o caractere $ (ex.: cr_connect).
# Configure este valor também nas variáveis de ambiente da Vercel.
INFINITEPAY_HANDLE=sua_infinite_tag
# Assistente de diagnóstico e procedimentos técnicos.
GEMINI_API_KEY=sua_chave_gemini

# Lembretes opcionais do Bolão (configure também na Vercel; nunca envie segredos ao Git).
# A chave pública VAPID pode ser enviada ao navegador. As demais ficam no servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua_chave_publica_vapid
VAPID_PRIVATE_KEY=sua_chave_privada_vapid
VAPID_SUBJECT=mailto:seu-email-de-contato@example.com
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_no_servidor
CRON_SECRET=segredo_aleatorio_de_pelo_menos_32_caracteres
BOLAO_PUSH_TEST_SECRET=outro_segredo_aleatorio_de_pelo_menos_32_caracteres
# Só habilite após aplicar a migration e confirmar um push real no aparelho de teste.
BOLAO_REMINDERS_ENABLED=false
